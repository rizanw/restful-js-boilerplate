# app config
APP_NAME=restful-js-boilerplate
APP_URL=http://localhost
APP_PORT=5000

# comma-separated list of browser origins allowed by CORS (default: APP_URL:APP_PORT)
CORS_ORIGINS=http://localhost:3000

# uri config
API_URI=/api/v1

# db config
MONGODB=mongodb://localhost:27017/myproject

# jwt config (required) — generate with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=6h

# comma-separated emails of existing users to promote to superuser on startup
SUPERUSER_EMAILS=
